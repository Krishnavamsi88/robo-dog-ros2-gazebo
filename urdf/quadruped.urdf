    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <!-- HIP LINK -->
  <link name="rear_right_hip">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="3.07125e-05" ixy="0" ixz="0" iyy="3.07125e-05" iyz="0" izz="1.08e-05"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.012"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.012"/>
      </geometry>
    </collision>
  </link>
  <!-- hip joint: abduction/adduction (rotation around Z-axis of body) -->
  <joint name="rear_right_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_right_hip"/>
    <origin rpy="0 0 0" xyz="-0.08650000000000001 -0.068 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" lower="-0.4" upper="0.4" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>
  <gazebo reference="rear_right_hip">
    <material>Gazebo/DarkGray</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>
  <!-- THIGH LINK -->
  <link name="rear_right_thigh">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000155" ixy="0" ixz="0" iyy="0.000155" iyz="0" izz="4e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.033"/>
      <geometry>
        <cylinder length="0.09" radius="0.015"/>
      </geometry>
      <material name="dark_metal">
        <color rgba="0.5 0.5 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.033"/>
      <geometry>
        <cylinder length="0.09" radius="0.015"/>
      </geometry>
    </collision>
  </link>
  <!-- thigh joint: forward/backward swing -->
  <joint name="rear_right_thigh_joint" type="revolute">
    <parent link="rear_right_hip"/>
    <child link="rear_right_thigh"/>
    <origin rpy="0 0 0" xyz="0 -0.0225 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" lower="-0.6" upper="0.3" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>
  <gazebo reference="rear_right_thigh">
    <material>Gazebo/Orange</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <!-- CALF LINK -->
  <link name="rear_right_calf">
    <inertial>
      <mass value="0.12"/>
      <inertia ixx="8.774999999999999e-05" ixy="0" ixz="0" iyy="8.774999999999999e-05" iyz="0" izz="1.35e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.045"/>
      <geometry>
        <cylinder length="0.09" radius="0.012"/>
      </geometry>
      <material name="silver">
        <color rgba="0.85 0.85 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.045"/>
      <geometry>
        <cylinder length="0.09" radius="0.012"/>
      </geometry>
    </collision>
  </link>
  <!-- knee joint: bending -->
  <joint name="rear_right_knee_joint" type="revolute">
    <parent link="rear_right_thigh"/>
    <child link="rear_right_calf"/>
    <origin rpy="0 0 0" xyz="0 0 -0.077"/>
    <axis xyz="0 1 0"/>
    <limit effort="40" lower="-1.0" upper="0.2" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>
  <gazebo reference="rear_right_calf">
    <material>Gazebo/Gray</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <!-- FOOT LINK -->
  <link name="rear_right_foot">
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="3.1360000000000006e-06" ixy="0" ixz="0" iyy="3.1360000000000006e-06" iyz="0" izz="3.1360000000000006e-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
  </link>
  <!-- foot joint: fixed to calf (foot sphere at bottom) -->
  <joint name="rear_right_foot_joint" type="fixed">
    <parent link="rear_right_calf"/>
    <child link="rear_right_foot"/>
    <origin rpy="0 0 0" xyz="0 0 -0.09"/>
  </joint>
  <gazebo reference="rear_right_foot">
    <material>Gazebo/Black</material>
    <!-- High friction rubber foot -->
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <!-- ==================== GAZEBO PLUGINS ==================== -->
  <!-- IMU Plugin -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- Camera Plugin -->
  <gazebo reference="camera_link">
    <sensor name="head_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera name="head_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/krish-pc/ros2_ws/src/quadruped_robot/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <ros2_control name="QuadrupedSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- FRONT LEFT -->
    <joint name="front_left_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_left_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_left_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <!-- FRONT RIGHT -->
    <joint name="front_right_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <!-- REAR LEFT -->
    <joint name="rear_left_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <!-- REAR RIGHT -->
    <joint name="rear_right_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_right_knee_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
</robot>
